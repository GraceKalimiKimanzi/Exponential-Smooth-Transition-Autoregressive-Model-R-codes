estar_lstar_test <- function (d){yt_d <- ylags[,d] #yt-d <- ylags[,d] selects the lagged variable that will serve as the STAR function
z1 <- ylags          #(yt-1, yt-2, yt-3, yt-4) representing the linear model under null hypothesis
z2 <- yt_d * ylags      #multiply each yt-d by the ylags. represents first order nonlnear term of the model
z3 <- (yt_d ^ 2) * ylags   #second order nonlinear term of the model
z4 <- (yt_d ^3) * ylags     #third order nonlinear term of the model
z <- cbind (z1, z2, z3, z4) #puts all groups of variables togeter into one big design matrix
full_model <- lm(yt~z)      #fits the unrestricted (full) auxiliary model
SSRU <-sum(resid(full_model)^2)
N <-nrow(z)
k <-length (coef(full_model))
model_Ho1 <- lm (yt ~ cbind(z1, z2, z3))
SSR_Ho1 <- sum(resid(model_Ho1)^2)
q1 <- ncol(z4)   #number of restrictions treated in H01
fo1 <- ((SSR_Ho1 - SSRU)/q1) / (SSRU/(N-k)) #computes the F statistics
po1 <- 1-pf(fo1, q1, N-k)   #Converts the F statistics into p_value
model_Ho2 <- lm(yt ~ cbind(z1,z2))
SSR_Ho2 <- sum (resid(model_Ho2)^2)
q2 <- ncol(z3) +ncol(z4)
fo2 <-((SSR_Ho2 - SSRU)/q2) / (SSRU / (N-k))
po2 <- 1 - pf(fo2, q2, N-k)
model_Ho3 <- lm(yt ~z1)
SSR_Ho3 <- sum(resid(model_Ho3)^2)
q3 <- ncol(z2) + ncol(z3) + ncol(z4)
fo3 <- ((SSR_Ho3 - SSRU)/q3) / (SSRU/(N-k))
po3 <- 1- pf (fo3, q3, N-k)
return (data.frame(Hypothesis = c("Ho1:c(Ho1: B4=0", "Ho2: B3=B4=0", "Ho3: B2=B3=B4=0"),
                    F_statistic = c(fo1, fo2, fo3),
                    p_value = c(po1, po2, po3)))
}
