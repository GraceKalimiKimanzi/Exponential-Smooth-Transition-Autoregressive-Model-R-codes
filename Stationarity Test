set.seed(123)         #to ensure the data is the same each time we run
simulate_series <- function(N, phi, sigma2, gamma, c, d){
  p <- 2
# Create empty vector
y <- numeric(N)

# Initialize starting values
y[1:2] <- 0 #The first 2 values of the series are set to zero

# Generate series
for (t in 3:N){                   # Here the series starts to generate from t=3 upto N
  Ft <- 1 - exp(-60 * (y[t - 2] - 0.08)^2)
  mu_t <- 0.01 + 1.55*y[t - 1] -0.88*y[t - 2] +
    (0.03 -1.05*y[t - 1] + 0.35*y[t - 2]) * Ft
  y[t] <- mu_t + rnorm(1, sd = sqrt(0.082))
}
return(y[-c(1:2)])}
y=simulate_series (N, phi, sigma2, gamma, c, d)

