T <- length(y)
ymat<- embed(y, p+1) #creates a matrix where exch row contains (y, yt-1,yt-2, yt-3, yt-4)
yt <- ymat[,1]      #Extracts the first column of the matrix ymat
ylags <-ymat[,-1]   #takes all the other columns except the first.
lm_test_star <- function (d){yt_d <- ylags[,d] #yt-d <- ylags[,d] selects the lagged variable that will serve as the STAR function
z1 <- ylags          #(yt-1, yt-2, yt-3, yt-4) representing the linear model under null hypothesis
z2 <- yt_d * ylags      #multiply each yt-d by the ylags. represents first order nonlnear term of the model
z3 <- (yt_d ^ 2) * ylags   #second order nonlinear term of the model
z4 <- (yt_d ^3) * ylags     #third order nonlinear term of the model
z <- cbind (z1, z2, z3, z4) #puts all groups of variables togeter into one big design matrix
model0 <-lm (yt ~ z1)       #model0 fits the restricted null model which assumes linearity
SSRO <- sum(resid(model0)^2) #SSRO is the sum of squared residuals for the linear regression model under the null hypothesis
model1 <- lm (yt ~ z)        #model1 fits the unrestricted full model
SSR1 <- sum(resid(model1)^2) #SSR1 is the sum of squared residuals based on the full auxiliary regression
lm <-(T-p)*(SSRO-SSR1)/SSRO #computes LM statistics for linearity test
df <- 3*p                   #degrees of freedom for the chi square distribution
pvalue <- 1-pchisq(lm,df)    #pvalue is obtained from the chi-square distribution with 3p degrees of fredom
return (c(lm=lm, p_value = pvalue))  
  }
results <- sapply (1:4, function (d)lm_test_star(d)) #runs lm test function for each possible delay parameter 1, 2,3,4
colnames(results) <-(paste ("d=", 1:4))
